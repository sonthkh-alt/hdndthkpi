# Sao chép file này thành .env và điền giá trị từ Supabase (Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ID Google Sheet "Bảng kiểm đếm" — DÙNG PHÍA MÁY CHỦ (không có tiền tố VITE_ nên KHÔNG lọt vào bundle trình duyệt).
# Lấy từ URL sheet: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# Khai báo trên Vercel: Settings -> Environment Variables -> SHEET_ID. (Hàm api/ chỉ chạy trên Vercel.)
SHEET_ID=your-google-sheet-id

# =====================================================================
#  BOT CHAT (Telegram / Zalo) — xem hướng dẫn đầy đủ ở docs/BOT-CHAT.md
#  TẤT CẢ các biến dưới đây chỉ dùng PHÍA MÁY CHỦ (không có tiền tố VITE_)
#  nên KHÔNG lọt vào mã tải về trình duyệt. Khai trên Vercel để bot chạy.
# =====================================================================

# 1) Đọc số liệu: Supabase -> Project Settings -> API Keys -> Secret keys (sb_secret_...).
#    Bản Supabase cũ thì lấy ở tab "Legacy API keys" -> service_role (chuỗi eyJ...).
#    Khai TÊN NÀO CŨNG ĐƯỢC: SUPABASE_SERVICE_ROLE_KEY hoặc SUPABASE_SECRET_KEY.
#    ⚠️ Khóa này BỎ QUA phân quyền RLS — tuyệt đối không chia sẻ, không đặt tên VITE_.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# 1b) Đọc LỊCH CÔNG TÁC TUẦN — phân hệ riêng (repo sonthkh-alt/calendar) dùng dự án
#     Supabase RIÊNG, nên khai thêm cặp biến này (lấy trong Vercel của dự án `calendar`).
#     Bỏ trống thì bot vẫn chạy, chỉ không trả lời được câu hỏi về lịch.
CAL_SUPABASE_URL=
CAL_SUPABASE_SERVICE_ROLE_KEY=

# 2) Bộ não AI — chỉ cần MỘT trong ba khóa sau.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Tùy chọn: ép dùng nhà cung cấp / mô hình cụ thể.
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-5
# Dùng DỊCH VỤ TRUNG GIAN "tương thích OpenAI" (khóa mua ngoài, cổng nội bộ…):
#   AI_PROVIDER=openai + OPENAI_API_KEY=<khóa của họ> + AI_MODEL=<tên mô hình của họ>
#   AI_BASE_URL=https://api.<nha-cung-cap>/v1   -> mã gọi <AI_BASE_URL>/chat/completions
# ⚠️ Mọi câu hỏi và số liệu nạp kèm sẽ đi qua máy chủ của bên trung gian đó.
# AI_BASE_URL=

# 2b) Phân hệ "Trợ lý AI nghiệp vụ dân cử" (#/troly) dùng CHUNG khóa AI ở trên và
#     SUPABASE_URL + khóa bí mật ở mục 1 — không bắt buộc khai thêm biến nào.
#     Mỗi lượt gọi AI đều tốn tiền nên có HẠN MỨC THEO NGÀY, đếm ở phía máy chủ
#     (dòng app_state id='troly_quota', đặt lại lúc 0 giờ giờ Việt Nam):
#       TROLY_QUOTA_KHACH      — số lượt/ngày cho khách chưa đăng nhập (mặc định 1)
#       TROLY_QUOTA_NGUOI_DUNG — số lượt/ngày cho người đã đăng nhập  (mặc định 5)
#     ⚠️ Bộ đếm cần SUPABASE_SERVICE_ROLE_KEY (mục 1). Thiếu khóa đó thì KHÁCH bị
#     từ chối gọi AI (để trần chi phí không bị vô hiệu hóa), người đã đăng nhập
#     vẫn dùng được. Thiếu khóa AI thì phân hệ vẫn mở nhưng báo "chưa cấu hình khóa AI".
# TROLY_QUOTA_KHACH=1
# TROLY_QUOTA_NGUOI_DUNG=5
#     Khung chat "Người hướng dẫn" ở Trang chủ (api/huongdan.js): câu ngoài kịch bản
#     được hỏi AI, mỗi khách mặc định 3 lượt/ngày (dòng app_state id='hd_quota'):
# HUONGDAN_QUOTA=3
#     Danh bạ điện thoại (hr_data.danhBa) mặc định CHỈ tra được qua bot Zalo/Telegram
#     (người dùng đã được Quản trị duyệt). Đặt =1 nếu muốn khách vô danh ở khung chat
#     Trang chủ cũng tra được (⚠️ số điện thoại thật, cân nhắc kỹ):
# DANHBA_KHACH=0

# 3) Telegram — token lấy từ @BotFather, ID lấy từ @userinfobot.
# Bot MỞ cho mọi người nhắn tới, nhưng phải được Quản trị duyệt (/dangky -> nút Đồng ý) mới hỏi được.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=            # ID Quản trị: người DUYỆT và được xem số liệu nhân sự (nhiều người cách nhau dấu phẩy)
TELEGRAM_ALLOWED_IDS=          # (tùy chọn) ID được dùng ngay, không cần đăng ký
TELEGRAM_WEBHOOK_SECRET=       # chuỗi bí mật tự đặt, dùng khi đăng ký webhook
BOT_DAILY_LIMIT=30             # (tùy chọn) số câu hỏi tối đa mỗi người mỗi ngày
TELEGRAM_OPEN=1                # (tùy chọn) đặt 0 để đóng đăng ký, chỉ phục vụ TELEGRAM_ALLOWED_IDS

# 4) Zalo Official Account (tùy chọn) — xem docs/BOT-CHAT.md mục 5.
#    Cần OA đã xác thực + ứng dụng ở developers.zalo.me. Quản trị vẫn DUYỆT người dùng
#    Zalo ngay trong Telegram, nên phải khai xong phần Telegram ở trên trước.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_WEBHOOK_SECRET=           # chuỗi bí mật tự đặt, gắn vào địa chỉ webhook ?secret=...
# ZALO_REFRESH_TOKEN=          # (tùy chọn) dán tay lần đầu thay cho bước xin quyền OAuth
